{
  "name": "agent-world",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" --filter \"./packages/server\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0"
    }
  }
}

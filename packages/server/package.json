{
  "name": "@agent-world/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:regression": "vitest run src/regression/",
    "rotate:reencrypt": "tsx scripts/rotate-reencrypt.ts",
    "migrate:postgres": "tsx scripts/migrate-to-postgres.ts",
    "backfill:usage": "tsx scripts/backfill-usage.ts",
    "generate:invoices": "tsx scripts/generate-invoices.ts"
  },
  "dependencies": {
    "@agent-world/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^10.0.8",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "stripe": "^22.6.2",
    "tesseract.js": "^7.0.0",
    "undici": "^8.10.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^24.13.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.23.13"
  }
}

{
  "name": "@agent-world/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && cp src/*.mjs dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:regression": "vitest run src/regression/",
    "rotate:reencrypt": "tsx scripts/rotate-reencrypt.ts",
    "migrate:postgres": "tsx scripts/migrate-to-postgres.ts",
    "backfill:usage": "tsx scripts/backfill-usage.ts",
    "generate:invoices": "tsx scripts/generate-invoices.ts",
    "prune:demo": "tsx scripts/prune-demo-users.ts",
    "reset:password": "tsx scripts/reset-password.ts",
    "selftest:errorsink": "tsx scripts/error-sink-selftest.ts"
  },
  "dependencies": {
    "@agent-world/core": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@model-hub/model-kit": "file:../../../model-hub/packages/model-kit",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "stripe": "^23.0.0",
    "tesseract.js": "^7.0.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "vitest": "5.0.5"
  }
}

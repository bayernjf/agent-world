{
  "name": "@agent-world/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:regression": "vitest run src/regression/",
    "rotate:reencrypt": "tsx scripts/rotate-reencrypt.ts"
  },
  "dependencies": {
    "@agent-world/core": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "bcryptjs": "^3.0.3",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "jose": "^6.2.10",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^9.0.6",
    "pdfjs-dist": "^6.2.108",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0",
    "undici": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.7",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2"
  }
}

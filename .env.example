# =====================================================================
# agent-world 环境变量模板
# 用法：cp .env.example .env 后填写真实值；.env 已被 .gitignore 忽略。
# 含 <占位符> 的是敏感值，绝不要把真实值提交进 git。
# 未列出的变量见各设计文档（如 storage.ts / permissions.ts / notify.ts）。
# =====================================================================

# ---------- 核心 ----------
# 数据库文件路径（默认 ./agent-world.sqlite）
DB_FILE=/var/lib/agent-world/agent-world.sqlite
# 日志文件路径（留空禁用落盘；默认 <DB目录>/logs/server.log）
LOG_FILE=/var/lib/agent-world/logs/server.log
# 日志级别：debug | info | warn | error（默认 info）
LOG_LEVEL=info
# server 端口（默认 8791）
PORT=8791
# 环境名（health 探针的 env 字段）：development | staging | production
AGENT_WORLD_ENV=staging
# Node 环境（生产 HTTPS 下 =production，secure cookie 判断等依赖它）
# NODE_ENV=production

# ---------- 密钥（敏感） ----------
# 内置 agnes 网关 key；缺失时内置模型 fail-closed
AGNES_API_KEY=<your-agnes-api-key>
# 备份模型源（通用 OpenAI 兼容槽，默认关闭；三项填齐才启用；文本灾备）
# BACKUP_BASE_URL=https://<backup-host>/v1
# BACKUP_API_KEY=<your-backup-api-key>
# BACKUP_MODELS=<backup-text-model>
# JWT 签名密钥（留空则首启自动生成 <DB目录>/.jwt-secret）
# JWT_SECRET=
# 静态加密密钥环（逗号分隔，新在前；留空则首启自动生成 <DB目录>/.encryption-keys）
# AGENT_WORLD_ENCRYPTION_KEYS=

# ---------- 注册 / 认证 ----------
# 注册默认关：仅首个账号 bootstrap。已有用户后如需开放注册，取消注释并 =1
# ALLOW_REGISTRATION=1
# 强制安全 cookie（生产 HTTPS 下 =1）
# SECURE_COOKIES=1
# Demo 体验账号（=1 开放 /api/demo 一键体验；默认关）
# ALLOW_DEMO=1

# ---------- 代码沙箱 ----------
# 沙箱后端：rlimit | bwrap | sandbox-exec | noop（默认 rlimit）
CODE_SANDBOX=bwrap
# 代码节点 CPU 时限（秒）/ 最大进程数
# CODE_LIMIT_CPU_SEC=30
# CODE_LIMIT_MAX_PROCS=64

# ---------- 成本 / 商业化 ----------
# 月度预算硬熔断放行（=1 临时放行，超预算紧急时 owner 用）
# AGENT_WORLD_BUDGET_BYPASS=1
# Stripe 收款（M3 账单 / BillingTab；三键填齐才启用订阅支付）
# STRIPE_SECRET_KEY=<your-stripe-secret-key>
# STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-secret>
# STRIPE_PRICE_IDS=<comma-separated-price-ids>
# 订阅 gate（dispatch-gate.ts；三档，不是开关二态）：
#   1 / true / yes     硬拦——超额派发回 402
#   observe / log      只观察——照常评估并打 "would block dispatch" 日志，但不拦
#   不设置 / 留空      关
# 其它值一律按「关」处理，并在日志里把你写的值点出来（避免写错当成已生效）。
# 已开硬拦前先跑 ≥24h observe，尤其确认 M1 四条 cron 回采产线没有 metric:"tokens"
# ——它们此前完全绕过 gate，硬拦后才第一次受套餐 token 配额约束。步骤见
# docs/runbooks/deploy-ubuntu-server.md §四之二。
# MONETIZATION_ENFORCE=observe

# ---------- 出站网络 / SSRF ----------
# 出站请求代理（如 http://127.0.0.1:7897）
# AGENT_WORLD_PROXY=
# 私有网络逃生口（默认拒绝内网地址；=1 放行）
# ALLOW_PRIVATE_NETWORK=1

# ---------- 存储 ----------
# 存储后端：local | s3（默认 local）
# STORAGE_BACKEND=local
# artifact 本地目录（默认 <DB目录>/artifacts）
# ARTIFACT_DIR=
# S3 兼容存储（STORAGE_BACKEND=s3 时）
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PREFIX=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- 搜索（search 节点兜底凭证，节点级可覆盖） ----------
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CX=

# ---------- 通知 ----------
# 运行 halt / 失败时的 webhook 通知
# RUN_HALT_WEBHOOK=
# RUN_FAILED_WEBHOOK=
# 错误追踪 webhook sink（未捕获异常上报；不设则只落 /api/admin/errors）
# ERROR_REPORT_WEBHOOK_URL=

# ---------- 邮件（SMTP 通知） ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---------- 集成 ----------
# MCP server（JSON 数组）
# MCP_SERVERS=[{"id":"sample","command":"node","args":["scripts/sample-mcp-server.mjs"]}]
# MCP 传输：stdio | http | sse
# AGENT_WORLD_MCP_TRANSPORT=
# worker 插件目录 / 离线测试用 fake worker
# WORKERS_DIR=
# WORKER=fake
# GitLab API URL（vcs 节点）
# GITLAB_API_URL=
# Slack bot token
# SLACK_BOT_TOKEN=

# ---------- 工具权限白名单 ----------
# TOOL_FS_ALLOW=
# TOOL_NETWORK_ALLOW=
# TOOL_NETWORK_EXTRA_PORTS=
# TOOL_SUBPROCESS_ALLOW=
# 插件 env 白名单 / 调用超时（ms）
# PLUGIN_ENV_ALLOWLIST=
# PLUGIN_CALL_TIMEOUT_MS=

# ---------- 其他 ----------
# CORS 白名单（逗号分隔）
# CORS_ORIGINS=
# 公开 URL（artifact 链接全限定）
# AGENT_WORLD_PUBLIC_URL=
# 配置文件路径（默认 ~/.agent-world/config.json）
# AGENT_WORLD_CONFIG=
# 部署身份（CI 注入，health 探针的 branch/commit 字段）
# AGENT_WORLD_GIT_BRANCH=
# AGENT_WORLD_GIT_COMMIT=
# metrics webhook 逃生口（无 secret 渠道默认拒绝）
# ALLOW_INSECURE_METRICS_WEBHOOK=1
# OCR 允许 host 白名单
# OCR_ALLOWED_HOSTS=
# 文件系统根（fs guard）
# AGENT_WORLD_FS_ROOT=

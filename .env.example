# =====================================================================
# agent-world 环境变量模板
# 用法：cp .env.example .env 后填写真实值；.env 已被 .gitignore 忽略。
# 含 <占位符> 的是敏感值，绝不要把真实值提交进 git。
# 未列出的变量见各设计文档（如 storage.ts / permissions.ts / notify.ts）。
# =====================================================================

# ---------- 核心 ----------
# 数据库文件路径（默认 ./agent-world.sqlite）
DB_FILE=/var/lib/agent-world/agent-world.sqlite
# 日志文件路径（留空禁用落盘；默认 <DB目录>/logs/server.log）
LOG_FILE=/var/lib/agent-world/logs/server.log
# 日志级别：debug | info | warn | error（默认 info）
LOG_LEVEL=info
# server 端口（默认 8791）
PORT=8791
# 环境名（health 探针的 env 字段）：development | staging | production
AGENT_WORLD_ENV=staging

# ---------- 密钥（敏感） ----------
# 内置 agnes 网关 key；缺失时内置模型 fail-closed
AGNES_API_KEY=<your-agnes-api-key>
# JWT 签名密钥（留空则首启自动生成 <DB目录>/.jwt-secret）
# JWT_SECRET=
# 静态加密密钥环（逗号分隔，新在前；留空则首启自动生成 <DB目录>/.encryption-keys）
# AGENT_WORLD_ENCRYPTION_KEYS=

# ---------- 注册 / 认证 ----------
# 已有用户后开放注册需 =1（否则仅首个账号 bootstrap）
ALLOW_REGISTRATION=1
# 强制安全 cookie（生产 HTTPS 下 =1）
# SECURE_COOKIES=1

# ---------- 代码沙箱 ----------
# 沙箱后端：rlimit | bwrap | sandbox-exec | noop（默认 rlimit）
CODE_SANDBOX=bwrap
# 代码节点 CPU 时限（秒）/ 最大进程数
# CODE_LIMIT_CPU_SEC=30
# CODE_LIMIT_MAX_PROCS=64

# ---------- 成本 / 商业化 ----------
# 月度预算硬熔断放行（=1 临时放行，超预算紧急时 owner 用）
# AGENT_WORLD_BUDGET_BYPASS=1
# 订阅 gate 开关（=1 启用 enforceSubscription，商业化 P1）
# MONETIZATION_ENFORCE=1

# ---------- 出站网络 / SSRF ----------
# 出站请求代理（如 http://127.0.0.1:7897）
# AGENT_WORLD_PROXY=
# 私有网络逃生口（默认拒绝内网地址；=1 放行）
# ALLOW_PRIVATE_NETWORK=1

# ---------- 存储 ----------
# 存储后端：local | s3（默认 local）
# STORAGE_BACKEND=local
# artifact 本地目录（默认 <DB目录>/artifacts）
# ARTIFACT_DIR=
# S3 兼容存储（STORAGE_BACKEND=s3 时）
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_PREFIX=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- 搜索（search 节点兜底凭证，节点级可覆盖） ----------
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CX=

# ---------- 通知 ----------
# 运行 halt / 失败时的 webhook 通知
# RUN_HALT_WEBHOOK=
# RUN_FAILED_WEBHOOK=

# ---------- 邮件（SMTP 通知） ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# ---------- 集成 ----------
# MCP server（JSON 数组）
# MCP_SERVERS=[{"id":"sample","command":"node","args":["scripts/sample-mcp-server.mjs"]}]
# MCP 传输：stdio | http | sse
# AGENT_WORLD_MCP_TRANSPORT=
# worker 插件目录 / 离线测试用 fake worker
# WORKERS_DIR=
# WORKER=fake
# GitLab API URL（vcs 节点）
# GITLAB_API_URL=
# Slack bot token
# SLACK_BOT_TOKEN=

# ---------- 工具权限白名单 ----------
# TOOL_FS_ALLOW=
# TOOL_NETWORK_ALLOW=
# TOOL_NETWORK_EXTRA_PORTS=
# TOOL_SUBPROCESS_ALLOW=
# 插件 env 白名单 / 调用超时（ms）
# PLUGIN_ENV_ALLOWLIST=
# PLUGIN_CALL_TIMEOUT_MS=

# ---------- 其他 ----------
# CORS 白名单（逗号分隔）
# CORS_ORIGINS=
# 公开 URL（artifact 链接全限定）
# AGENT_WORLD_PUBLIC_URL=
# 配置文件路径（默认 ~/.agent-world/config.json）
# AGENT_WORLD_CONFIG=
# 部署身份（CI 注入，health 探针的 branch/commit 字段）
# AGENT_WORLD_GIT_BRANCH=
# AGENT_WORLD_GIT_COMMIT=
# metrics webhook 逃生口（无 secret 渠道默认拒绝）
# ALLOW_INSECURE_METRICS_WEBHOOK=1
# OCR 允许 host 白名单
# OCR_ALLOWED_HOSTS=
# 文件系统根（fs guard）
# AGENT_WORLD_FS_ROOT=
